# ─────────────────────────────────────────────────────────────
# StepPay configuration. Copy this file to `.env.local` for local
# development, or add the same variables in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, Railway, local Postgres...).
# Leave it EMPTY for local development: an embedded database (PGlite) is
# created automatically in ./.data — nothing to install.
DATABASE_URL=

# Public URL of the deployed portal, used in docs and code snippets.
# Example: https://steppay.vercel.app  (leave empty locally)
NEXT_PUBLIC_APP_URL=

# Comma separated e-mails that get the Lecturer (admin) role on sign up / sign in.
ADMIN_EMAILS=lecturer@example.com

# Optional: students must type this code to register (keeps strangers out).
# Leave empty to allow open registration.
REGISTRATION_CODE=

# Time zone used for dashboards and reports.
APP_TIMEZONE=Asia/Tbilisi

# Allow server callbacks to localhost / private networks.
# Always allowed in development; set to 1 to also allow in production.
ALLOW_PRIVATE_CALLBACKS=
